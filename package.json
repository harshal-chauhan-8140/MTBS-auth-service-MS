{
   "name": "user-service",
   "version": "1.0.0",
   "description": "",
   "license": "ISC",
   "author": "",
   "type": "module",
   "main": "index.js",
   "scripts": {
      "dev": "cross-env NODE_ENV=dev nodemon --watch src --ext ts --exec tsx src/server.ts",
      "test": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
      "test:watch": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --watch --runInBand",
      "start": "ts-node src/index.ts",
      "build": "tsc",
      "format": "prettier --write .",
      "format:check": "prettier --check .",
      "lint": "eslint .",
      "check": "npm run lint && npm run format:check && npm run build",
      "prepare": "husky",
      "typeorm": "typeorm-ts-node-commonjs"
   },
   "devDependencies": {
      "@eslint/js": "^10.0.1",
      "@types/bcrypt": "^6.0.0",
      "@types/cookie-parser": "^1.4.10",
      "@types/http-errors": "^2.0.5",
      "@types/jest": "^30.0.0",
      "@types/jsonwebtoken": "^9.0.10",
      "@types/node": "^26.2.0",
      "@types/pg": "^8.21.0",
      "@types/supertest": "^7.2.1",
      "eslint": "^10.8.1",
      "husky": "^9.1.7",
      "jest": "^30.4.2",
      "lint-staged": "^17.3.0",
      "mock-jwks": "^3.3.5",
      "nodemon": "^3.1.14",
      "prettier": "3.9.6",
      "supertest": "^7.2.2",
      "ts-jest": "^29.4.12",
      "ts-node": "^10.9.2",
      "tsx": "^4.23.12",
      "typescript": "^5.9.3",
      "typescript-eslint": "^8.67.0"
   },
   "lint-staged": {
      "*.{ts,mjs}": [
         "eslint --fix",
         "prettier --write"
      ],
      "*.{json,md,yml}": "prettier --write"
   },
   "dependencies": {
      "@types/express": "^5.0.6",
      "bcrypt": "^6.0.0",
      "cookie-parser": "^1.4.7",
      "cross-env": "^10.1.0",
      "dotenv": "^17.4.2",
      "express": "^5.2.1",
      "express-jwt": "^8.5.1",
      "express-validator": "^7.3.2",
      "http-errors": "^2.0.1",
      "jsonwebtoken": "^9.0.3",
      "jwks-rsa": "^4.1.0",
      "pg": "^8.23.0",
      "reflect-metadata": "^0.2.2",
      "rsa-pem-to-jwk": "^1.1.3",
      "typeorm": "1.0.0",
      "uuid": "^14.0.1"
   }
}
